# 실제 키는 .env 에 저장하고 절대 커밋하지 않습니다 (지침 §19, 금지사항)
# 사용법: copy .env.example .env  후 값 입력

# ── VWorld 오픈API ───────────────────────────────────────────
# VWORLD_API_KEY : 브이월드 > 오픈API > 인증키 발급 에서 받은 키
VWORLD_API_KEY=

# VWORLD_DOMAIN : 새로 정하는 값이 아니라, "인증키 발급 시 등록한 URL"과
#   동일한 문자열을 적습니다. (마이페이지 > 인증키 관리 > 사이트 URL 확인)
#   - 지오코딩 REST(api.vworld.kr/req/address): key만 필수. 인증 거부 시
#     Referer 헤더에 이 값을 넣어 호출합니다.
#   - 지도 JS API(map.vworld.kr/js/apis.do): URL에 domain= 으로 전달되며
#     브라우저 Referer도 등록값과 일치해야 합니다.
#   - 로컬 대시보드는 file:// 로 열면 Referer가 없어 인증 실패합니다.
#     반드시 http://localhost:8080 등 로컬 서버로 서빙하십시오.
#   예) localhost   또는   kchglobal.co.kr
VWORLD_DOMAIN=localhost

# 대시보드 로컬 서빙 포트 (등록 도메인이 localhost일 때 Referer 생성용)
DASHBOARD_PORT=8080

# ── Google Sheets ────────────────────────────────────────────
# 서비스계정 JSON 파일 경로. 키 원문을 코드/시트/로그에 넣지 않습니다.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── 수집기 매너 설정 (지침 §7.1 서버 부하 고려) ──────────────
REQUEST_DELAY_SEC=1.5
REQUEST_TIMEOUT_SEC=30
MAX_RETRIES=3
USER_AGENT=jeonnam-re-data-collector/0.1 (contact: jhseo@kchglobal.co.kr)
